# ============================================================
# Kavita TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Kavita 上游版本（GitHub tag，不带 v 前缀）
KAVITA_VERSION=0.9.1.4

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 0.9.1.4-1
# 三处必须一致：config.ini / DEBIAN/control / .lang；
# 每次提交商店严格递增；Release tag = v<完整版本>
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=2

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
# 规则：小写字母/数字/连字符，字母开头，≤50 字符
APP_ID=kavita

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=kavita

# 回环监听端口（官方推荐 8000-19999 段；8500 为选定值，
# 已与兄弟项目 metube 8081 / navidrome 8453 / audiobookshelf 13378 /
# vaultwarden 8222 错开；上游默认 5000 不用于本包）
APP_PORT=8500

# 上游 Release 资产的 sha256 锚点（上游不发布 checksums 文件，
# 首次 fetch 后由 build.sh 把实测值写入 build/downloads/sha256.lock，
# 建议固化到这里以保证可复现构建；留空则按 lock 文件校验）
KAVITA_X64_SHA256=609805b394132d5c1ad8ecef312654fd93b6b06af59b4b1d909e75b81a91860b
KAVITA_ARM64_SHA256=1384aa60c32d4ec35c4d2085cb9ade9d97b3564f3491211c7d35bf4d8b60c740

# deb 维护者信息（DEBIAN/control 的 Maintainer 与 config.ini 的 publisher）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"
