# ============================================================
# Kavita TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Kavita 上游版本（GitHub tag，不带 v 前缀）
KAVITA_VERSION=0.9.1.4

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 0.9.1.4-1
# 三处必须一致：config.ini / DEBIAN/control / .lang；
# 每次提交商店严格递增；Release tag = v<完整版本>
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=2

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
# 规则：小写字母/数字/连字符，字母开头，≤50 字符
APP_ID=kavita

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=kavita

# 回环监听端口（官方推荐 8000-19999 段；8500 为选定值，
# 已与兄弟项目 metube 8081 / navidrome 8453 / audiobookshelf 13378 /
# vaultwarden 8222 错开；上游默认 5000 不用于本包）
APP_PORT=8500

# 二进制来源（审核 V6，一票否决项）：不从上游 Release 下载预编译 tarball，
# 改用公开 CI 从上游源码 tag 自建（Moechz/kavita 的 build-upstream.yml，
# 步骤与上游 release-workflow.yml 逐字对齐：Node 24 编 WebUI +
# monorepo-build.sh dotnet publish）。
# fetch 阶段对 Release SHA256SUMS 与下方锚点双层互验；
# sha256 值在 CI 构建完成后回填（留空则按 lock 文件校验）。
# 上游源码：https://github.com/Kareadita/Kavita
SELF_BUILD_REPO="Moechz/kavita"
# 来源：https://github.com/Moechz/kavita/releases/download/build-v0.9.1.4/SHA256SUMS
# （Actions run 35430046787，2026-09-19）
KAVITA_X64_SHA256=e2c0bfd00f84054f728cfeaf84f855b0bb5fc2fc8b46a9e660e302a901fedbcb
KAVITA_ARM64_SHA256=4421f55fa85790d385e62e4833595fd70aa2cb3589a4c7b33ae666675ba1e140

# deb 维护者信息：control 的 Maintainer 填打包者（包出问题找谁，坑 49）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
# 坑 49 署名分工（用户明确指示，勿再改回）：
#   lang 的 auth          = 上游作者（Kavita Team）—— 作者字段铁律归上游
#   config.ini publisher  = Moechz（本机打包者/移植发布者）
#   control Maintainer    = Moechz
# 商店「Developer」行来自开发者平台账号名，「Publisher」行来自本字段
PUBLISHER="Moechz"
