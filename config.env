# ============================================================
# Kavita TOS 7 App Center deb packaging configuration
# After editing, re-run ./build.sh
# ============================================================

# Kavita upstream version (GitHub tag, without the v prefix)
KAVITA_VERSION=0.9.1.4

# Packaging iteration number (our own release counter)
# Full version = upstream version-iteration, e.g. 0.9.1.4-1
# Must be identical in three places: config.ini / DEBIAN/control / .lang;
# strictly increment for every store submission; Release tag = v<full version>
# NOTE: never zero-pad the iteration: dpkg treats -01 == -1
PKG_RELEASE=2

# Target architecture (CPU architecture of the TOS NAS):
#   amd64 - Intel/AMD x86_64 (most TerraMaster NAS models)
#   arm64 - ARM64/aarch64 models
TARGET_ARCH=amd64

# TOS application id (the /usr/local/<appid>/ directory, config.ini's id/system_id,
# the lang file name and the icon file name must all match; immutable after release)
# Rules: lowercase letters/digits/hyphens, starting with a letter, <= 50 characters
APP_ID=kavita

# Runtime user (the specification requires a dedicated non-root user, created by preinst;
# config.ini.user and the systemd User must match)
APP_USER=kavita

# Loopback port (official recommendation: 8000-19999; 8500 chosen here,
# kept clear of sibling projects metube 8081 / navidrome 8453 / audiobookshelf 13378 /
# vaultwarden 8222; the upstream default 5000 is not used by this package)
APP_PORT=8500

# Binary source (review item V6, an automatic rejection): the package does not download the
# upstream prebuilt tarball; a public CI workflow builds from the upstream source tag
# (Moechz/kavita build-upstream.yml, mirroring the upstream release-workflow.yml: Node 24 WebUI build +
# monorepo-build.sh dotnet publish）。
# fetch double-verifies the release SHA256SUMS against the pins below;
# the sha256 values are filled in after the CI build (empty = verify against the local lock file).
# Upstream source: https://github.com/Kareadita/Kavita
SELF_BUILD_REPO="Moechz/kavita"
# Source: https://github.com/Moechz/kavita/releases/download/build-v0.9.1.4/SHA256SUMS
# （Actions run 35430046787，2026-09-19）
KAVITA_X64_SHA256=e2c0bfd00f84054f728cfeaf84f855b0bb5fc2fc8b46a9e660e302a901fedbcb
KAVITA_ARM64_SHA256=4421f55fa85790d385e62e4833595fd70aa2cb3589a4c7b33ae666675ba1e140

# deb maintainer information: control's Maintainer is the packager (who to contact about the package, pitfall 49)
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
# Pitfall 49 attribution split (explicit user instruction, do not revert):
#   lang auth             = upstream author (Kavita Team) - the author field always belongs to upstream
#   config.ini publisher  = Moechz (the local packager / port publisher)
#   control Maintainer    = Moechz
# The store's Developer row comes from the developer platform account name; the Publisher row shows this field
PUBLISHER="Moechz"
