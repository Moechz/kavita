# ============================================================
# Kavita user configuration (copied from kavita.env.example on first install)
# After editing, run: systemctl restart kavita
#
# Note: Kavita configuration (port / listen address / sub-path) cannot be overridden by environment
# variables (upstream Program.cs clears the environment configuration source and reads only
#  config/appsettings.json, i.e. /var/lib/kavita/appsettings.json), so this file only carries process-level variables.
# To change port / listen address / BaseUrl, edit /var/lib/kavita/appsettings.json and restart the service.
# ============================================================

# Timezone (affects local-time display of scan schedules / task scheduling; defaults to the system value)
#TZ=Asia/Shanghai

# .NET runtime switches (tune on memory-constrained devices; see the .NET documentation)
# While scanning a large library the .NET GC heap may grow to several GB; the example below pins the soft cap at 1 GB
#DOTNET_GCHeapHardLimit=1073741824
# Server GC (throughput first, higher memory usage; the default workstation GC uses less memory)
#DOTNET_gcServer=0
