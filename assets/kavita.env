# ============================================================
# Kavita 用户配置（由 kavita.env.example 首装复制而来）
# 修改后执行: systemctl restart kavita
#
# 说明：Kavita 的业务配置（端口/监听地址/子路径）不支持环境变量覆盖
# （上游 Program.cs 清空了环境变量配置源，只读 config/appsettings.json，
#  即 /var/lib/kavita/appsettings.json），因此本文件只承载进程级环境变量。
# 改端口/监听地址/BaseUrl 请编辑 /var/lib/kavita/appsettings.json 后重启服务。
# ============================================================

# 时区（影响扫描计划/任务调度的本地时间显示；默认跟随系统）
#TZ=Asia/Shanghai

# .NET 运行时开关（内存紧张的机型可按需调整；详见 .NET 文档）
# 大库扫描时 .NET GC 堆可能涨到数 GB，下例把堆软上限钉在 1GB
#DOTNET_GCHeapHardLimit=1073741824
# 服务器 GC（吞吐优先，内存占用更高；默认 workstation GC 更省内存）
#DOTNET_gcServer=0
