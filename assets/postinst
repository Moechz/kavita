#!/bin/bash
# postinst - 安装/升级后处理
# 组件树（/usr/local/kavita 下的二进制/WebUI/服务）随 deb 分发，
# postinst 负责"派生状态"：属主、webui 解压、数据卷与配置首装引导、
# config 符号链接自愈、系统层注册（服务+nginx）、启动与就绪检查。
# 注：经 TOS 应用中心安装时平台也会注册 init.d 服务与 nginx 配置，
# 本脚本的操作全部幂等，两条安装路径行为一致。
set -e

APP_DIR=/usr/local/kavita
APP_BIN=$APP_DIR/bin
APP_USER=kavita
DATA_DIR=/var/lib/kavita
MAINT_LOG=/var/log/kavita-maint.log

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postinst "$1" "new=@VERSION@${2:+ old=$2}"

case "$1" in
  configure)
    # 1. 用户兜底（preinst 已建；平台自动创建路径亦覆盖）
    if ! id -u $APP_USER > /dev/null 2>&1; then
      useradd --system --user-group --no-create-home --shell /usr/sbin/nologin $APP_USER 2>/dev/null || true
    fi

    # 2. 文件属主（官方 postinst 模板：应用目录归运行用户；
    #    chown -R 不跟随符号链接，不会误改 /var/lib 数据卷属主）
    chown -R $APP_USER:$APP_USER "$APP_DIR" 2>/dev/null || true

    # 3. 解压 webui.bz2（官方模板行为；External 模式下为占位页）
    if [ -f "$APP_DIR/webui.bz2" ]; then
      ( cd "$APP_DIR" && tar -xjf webui.bz2 2>/dev/null || true )
    fi

    # 4. 数据卷（数据库/封面/缓存/日志/书签/主题 + 默认库目录）
    install -d -o $APP_USER -g $APP_USER -m 0750 \
      "$DATA_DIR" "$DATA_DIR/library"

    # 5. Kavita 配置首装引导（永不覆盖用户配置）：
    #    Kavita 首启会把 appsettings-init.json 重命名为 appsettings.json，
    #    并自动生成 JWT TokenKey（上游 Program.cs EnsureJwtTokenKey）。
    #    因此这里只在两者都不存在时投放 init 模板，其余交给应用自身。
    if [ ! -e "$DATA_DIR/appsettings.json" ] && [ ! -e "$DATA_DIR/appsettings-init.json" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/config-template/appsettings-init.json" \
        "$DATA_DIR/appsettings-init.json"
      pkg_log postinst bootstrap "appsettings-init.json 首装"
    fi

    # 6. env 文件首装引导（进程级环境变量；同坑 2 规则：只在缺失时复制）
    if [ ! -e "$APP_DIR/kavita.env" ] && [ -e "$APP_DIR/kavita.env.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/kavita.env.example" "$APP_DIR/kavita.env"
      pkg_log postinst bootstrap "kavita.env 首装"
    fi

    # 7. config 符号链接自愈（deb 随包分发 bin/config -> /var/lib/kavita；
    #    Kavita 一切状态目录均相对 CWD 的 config/ 解析，链接断则状态写进 /usr）
    if [ ! -L "$APP_BIN/config" ]; then
      if [ -d "$APP_BIN/config" ] && [ ! -L "$APP_BIN/config" ]; then
        # 异常路径：config 是真实目录（手工运行过 Kavita 的残留）
        echo "警告: $APP_BIN/config 是真实目录而非符号链接。" >&2
        echo "      如需保留其中数据，请先将其内容合并进 $DATA_DIR 后手工" >&2
        echo "      执行: rm -rf $APP_BIN/config && ln -s $DATA_DIR $APP_BIN/config" >&2
      else
        rm -f "$APP_BIN/config" 2>/dev/null || true
        ln -s "$DATA_DIR" "$APP_BIN/config"
        pkg_log postinst "config 符号链接自愈"
      fi
    fi
    chown -h $APP_USER:$APP_USER "$APP_BIN/config" 2>/dev/null || true

    # 8. 系统层注册（幂等；应用中心安装时平台也会做同样的事）
    install -m 0644 "$APP_DIR/init.d/kavita.service" \
      /etc/systemd/system/kavita.service
    systemctl daemon-reload

    # 启用（幂等，升级路径 prerm 只停不拆故必须重 enable）并（重）启动
    systemctl enable kavita.service > /dev/null 2>&1 || true
    if [ -n "${2:-}" ]; then
      systemctl restart kavita.service 2>/dev/null || true
    else
      systemctl start kavita.service 2>/dev/null || true
    fi

    # 9. nginx 路由（TOS 平台会加载 nginx/<appid>.conf，此处在系统 nginx 兜底注册）
    # 注意：裸 location 仅在 server 上下文合法（TOS 的 conf.d 即 include 在 server 层）；
    # 写入后立即 nginx -t 校验，失败则回滚，绝不留下导致 nginx 无法 reload 的配置
    if command -v nginx > /dev/null 2>&1 && [ -d /etc/nginx/conf.d ]; then
      install -m 0644 "$APP_DIR/nginx/kavita.conf" \
        /etc/nginx/conf.d/kavita.conf
      if nginx -t > /dev/null 2>&1; then
        nginx -s reload > /dev/null 2>&1 || true
      else
        rm -f /etc/nginx/conf.d/kavita.conf
        echo "提示: 本机 nginx 的 conf.d 不在 server 上下文，已跳过自动注册 /kavita/。" >&2
        echo "      请把 $APP_DIR/nginx/kavita.conf 的 location 段手工加入对应 server 块。" >&2
      fi
    fi

    # 10. 就绪检查（坑 26：restart 成功 ≠ 就绪）。Kavita 首启要跑数据库
    #     迁移后才开始监听，这里轮询免认证健康接口最多 60s，超时打有限快照，
    #     不作为安装失败条件（大库升级迁移可能更久，属正常）
    pkg_log postinst "就绪轮询开始"
    ready=0
    for i in $(seq 1 20); do
      if curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:8500/kavita/api/health 2>/dev/null; then
        ready=1
        break
      fi
      if systemctl is-failed --quiet kavita.service; then
        break
      fi
      sleep 3
    done
    if [ "$ready" = "1" ]; then
      pkg_log postinst "就绪检查通过（HTTP 200）"
    else
      pkg_log postinst "就绪检查未通过（可能在跑首次迁移），状态快照如下"
      echo "提示: Kavita 未在 60 秒内就绪（首次启动需初始化数据库，稍等片刻属正常）。" >&2
      systemctl status kavita.service --no-pager -l 2>/dev/null | head -15 >&2 || true
      echo "      如持续未就绪: journalctl -u kavita -n 50 --no-pager" >&2
    fi

    pkg_log postinst done "@VERSION@"
    echo ""
    if [ -n "${2:-}" ]; then
      echo "Kavita @VERSION@ 已完成升级（自 $2）。"
    else
      echo "Kavita @VERSION@ 已安装。"
    fi
    echo "  打开界面 : TOS 桌面 → Kavita 图标（新标签页打开 http://<NAS的IP>:8181/kavita/）"
    echo "  首次使用 : 打开网页 → 创建管理员账号（首访向导，即完成初始化）"
    echo "  建库阅读 : 网页内 Server Settings → Libraries → 添加库目录"
    echo "             默认库目录 /var/lib/kavita/library，也可指向共享文件夹"
    echo "             （需 kavita 用户可读: chmod -R a+rX <目录>）"
    echo "  数据位置 : /var/lib/kavita（数据库/封面/缓存/日志）"
    echo "  端口说明 : 仅监听 127.0.0.1:8500，不对外暴露端口（经 TOS nginx 路由访问）"
    echo ""
    ;;
esac

exit 0
