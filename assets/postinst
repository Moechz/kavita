#!/bin/bash
# postinst - post-install / post-upgrade handling
# The component tree (binaries/WebUI/service under /usr/local/kavita) ships with the deb;
# postinst is responsible for derived state: ownership, webui extraction, data volume and first-run
# configuration bootstrap, config symlink self-healing, system-level registration (service + nginx), startup and readiness check.
# Note: when installed through the TOS App Center the platform also registers the init.d service and
# nginx configuration; every operation below is idempotent, so both install paths behave the same.
set -e

APP_DIR=/usr/local/kavita
APP_BIN=$APP_DIR/bin
APP_USER=kavita
DATA_DIR=/var/lib/kavita
MAINT_LOG=/var/log/kavita-maint.log

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postinst "$1" "new=@VERSION@${2:+ old=$2}"

case "$1" in
  configure)
    # 1. User fallback (already created by preinst; also covers the platform's automatic creation)
    if ! id -u $APP_USER > /dev/null 2>&1; then
      useradd --system --user-group --no-create-home --shell /usr/sbin/nologin $APP_USER 2>/dev/null || true
    fi

    # 2. File ownership (per the official postinst template: the app directory belongs to the runtime user;
    #    chown -R does not follow symlinks, so the /var/lib data volume ownership is untouched)
    chown -R $APP_USER:$APP_USER "$APP_DIR" 2>/dev/null || true

    # 3. Extract webui.bz2 (official template behaviour; a placeholder page in External mode)
    if [ -f "$APP_DIR/webui.bz2" ]; then
      ( cd "$APP_DIR" && tar -xjf webui.bz2 2>/dev/null || true )
    fi

    # 4. Data volume (database/covers/cache/logs/bookmarks/themes + default library directory)
    install -d -o $APP_USER -g $APP_USER -m 0750 \
      "$DATA_DIR" "$DATA_DIR/library"

    # 5. Kavita configuration bootstrap (never overwrites a user configuration):
    #    On first start Kavita renames appsettings-init.json to appsettings.json
    #    and generates the JWT TokenKey itself (upstream Program.cs EnsureJwtTokenKey).
    #    So the init template is only dropped when neither file exists; the rest is up to the app.
    if [ ! -e "$DATA_DIR/appsettings.json" ] && [ ! -e "$DATA_DIR/appsettings-init.json" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/config-template/appsettings-init.json" \
        "$DATA_DIR/appsettings-init.json"
      pkg_log postinst bootstrap "appsettings-init.json bootstrap"
    fi

    # 6. env file bootstrap (process-level environment; same rule as pitfall 2: copy only when missing)
    if [ ! -e "$APP_DIR/kavita.env" ] && [ -e "$APP_DIR/kavita.env.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/kavita.env.example" "$APP_DIR/kavita.env"
      pkg_log postinst bootstrap "kavita.env bootstrap"
    fi

    # 7. config symlink self-healing (the deb ships bin/config -> /var/lib/kavita;
    #    every Kavita state directory is resolved relative to CWD's config/, so a broken link writes state into /usr)
    if [ ! -L "$APP_BIN/config" ]; then
      if [ -d "$APP_BIN/config" ] && [ ! -L "$APP_BIN/config" ]; then
        # Abnormal path: config is a real directory (leftover from running Kavita manually)
        echo "warning: $APP_BIN/config is a real directory, not a symlink." >&2
        echo "      To keep its data, merge the contents into $DATA_DIR first, then run:" >&2
        echo "      rm -rf $APP_BIN/config && ln -s $DATA_DIR $APP_BIN/config" >&2
      else
        rm -f "$APP_BIN/config" 2>/dev/null || true
        ln -s "$DATA_DIR" "$APP_BIN/config"
        pkg_log postinst "config symlink self-healed"
      fi
    fi
    chown -h $APP_USER:$APP_USER "$APP_BIN/config" 2>/dev/null || true

    # 8. System-level registration (idempotent; the App Center does the same on its install path)
    install -m 0644 "$APP_DIR/init.d/kavita.service" \
      /etc/systemd/system/kavita.service
    systemctl daemon-reload

    # Enable (idempotent; prerm only stops on upgrade, so re-enabling here is required) and (re)start
    systemctl enable kavita.service > /dev/null 2>&1 || true
    if [ -n "${2:-}" ]; then
      systemctl restart kavita.service 2>/dev/null || true
    else
      systemctl start kavita.service 2>/dev/null || true
    fi

    # 9. nginx route (the TOS platform loads nginx/<appid>.conf; this registers it in the system nginx as a fallback)
    # Note: a bare location block is only valid in the server context (TOS includes conf.d at server level);
    # validate with nginx -t right after writing and roll back on failure, never leaving a config that breaks nginx reload
    if command -v nginx > /dev/null 2>&1 && [ -d /etc/nginx/conf.d ]; then
      install -m 0644 "$APP_DIR/nginx/kavita.conf" \
        /etc/nginx/conf.d/kavita.conf
      if nginx -t > /dev/null 2>&1; then
        nginx -s reload > /dev/null 2>&1 || true
      else
        rm -f /etc/nginx/conf.d/kavita.conf
        echo "note: this host's nginx conf.d is not in the server context; skipped automatic /kavita/ registration." >&2
        echo "      Please add the location block from $APP_DIR/nginx/kavita.conf to the matching server block manually." >&2
      fi
    fi

    # 10. Readiness check (pitfall 26: a successful restart is not readiness). Kavita only starts
    #     listening after the database migration, so poll the unauthenticated health endpoint for up to 60s;
    #     on timeout print a bounded snapshot - not an install failure condition (large-library upgrades take longer)
    pkg_log postinst "readiness polling started"
    ready=0
    for i in $(seq 1 20); do
      if curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:8500/kavita/api/health 2>/dev/null; then
        ready=1
        break
      fi
      if systemctl is-failed --quiet kavita.service; then
        break
      fi
      sleep 3
    done
    if [ "$ready" = "1" ]; then
      pkg_log postinst "readiness check passed (HTTP 200)"
    else
      pkg_log postinst "readiness check did not pass (possibly still migrating); status snapshot follows"
      echo "note: Kavita was not ready within 60 seconds (first start initialises the database; a short wait is normal)." >&2
      systemctl status kavita.service --no-pager -l 2>/dev/null | head -15 >&2 || true
      echo "      If it stays unready: journalctl -u kavita -n 50 --no-pager" >&2
    fi

    pkg_log postinst done "@VERSION@"
    echo ""
    if [ -n "${2:-}" ]; then
      echo "Kavita @VERSION@ upgraded successfully (from $2)."
    else
      echo "Kavita @VERSION@ installed."
    fi
    echo "  Open UI     : TOS desktop -> Kavita icon (opens http://<NAS-IP>:8181/kavita/ in a new tab)"
    echo "  First use   : open the web UI -> create the admin account (the first-run wizard completes setup)"
    echo "  Libraries   : web UI -> Server Settings -> Libraries -> add library folders"
    echo "                default library folder /var/lib/kavita/library; a shared folder works too"
    echo "                (must be readable by the kavita user: chmod -R a+rX <dir>)"
    echo "  Data        : /var/lib/kavita (database / covers / cache / logs)"
    echo "  Ports       : listens on 127.0.0.1:8500 only, no external port (accessed via the TOS nginx route)"
    echo ""
    ;;
esac

exit 0
