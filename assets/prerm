#!/bin/bash
# prerm - pre-remove / pre-upgrade handling (official template: kill leftover processes of the app user + stop the service)
set -e

MAINT_LOG=/var/log/kavita-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') prerm $*" >> "$MAINT_LOG" 2>/dev/null || true

# Kill leftover processes of the application user (upgrade safety; Kavita also runs scans and other background jobs)
pkill -u kavita 2>/dev/null || true
sleep 1

# Stop the service (the upgrade path only stops - it must not disable; the new postinst re-enables it; dpkg replaces the unit file)
systemctl stop kavita.service 2>/dev/null || true
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
  systemctl disable kavita.service 2>/dev/null || true
fi

exit 0
