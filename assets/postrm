#!/bin/bash
# postrm - post-remove / post-purge handling (official template + application-specific cleanup)
set -e

MAINT_LOG=/var/log/kavita-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') postrm $*" >> "$MAINT_LOG" 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true

if [ "$1" = "purge" ]; then
  # Database, covers, cache, logs, bookmarks (kept on remove, fully removed on purge;
  # the comic/book source files live in the user's library folders, not under /var/lib/kavita, and are never touched)
  rm -rf /var/lib/kavita
  # System-level registration files (installed as a fallback by postinst)
  rm -f /etc/systemd/system/kavita.service
  rm -f /etc/nginx/conf.d/kavita.conf
  # Runtime user
  if id -u kavita > /dev/null 2>&1; then
    userdel kavita 2>/dev/null || true
  fi
  systemctl daemon-reload 2>/dev/null || true
  # Reload after removing the nginx route
  if command -v nginx > /dev/null 2>&1 && nginx -t > /dev/null 2>&1; then
    nginx -s reload > /dev/null 2>&1 || true
  fi
  # Note: /var/log/kavita-maint.log is kept for post-mortem purposes
  # Note: /usr/local/kavita is removed by dpkg from the package manifest (including the bin/config symlink);
  # files derived by postinst are not in the manifest, so they are cleaned here to avoid leftover directories:
  #   index.html (extracted webui placeholder page) and kavita.env (first-run configuration).
  #   bin/config (the symlink recreated by postinst) is removed defensively as well
  rm -f /usr/local/kavita/index.html
  rm -f /usr/local/kavita/kavita.env
  rm -f /usr/local/kavita/bin/config
  rmdir --ignore-fail-on-non-empty /usr/local/kavita/bin /usr/local/kavita 2>/dev/null || true
fi

exit 0
