#!/bin/bash
# preinst - 安装/升级前处理（TOS 规范：专用用户必须在 preinst 创建）
set -e

MAINT_LOG=/var/log/kavita-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') preinst $*" >> "$MAINT_LOG" 2>/dev/null || true

# 创建专用系统用户（平台安装路径下亦会自动创建；此处保证手动 apt 安装也可用；
# --user-group 显式建同名主组，不依赖 USERGROUPS_ENAB 默认值）
if ! id -u kavita > /dev/null 2>&1; then
  useradd --system --user-group --no-create-home --shell /usr/sbin/nologin kavita 2>/dev/null || true
fi

# 数据目录（/usr/local/kavita/bin/config 符号链接的落点：
# 数据库、封面、缓存、日志、书签、主题等全部状态）
mkdir -p /var/lib/kavita
chown -R kavita:kavita /var/lib/kavita 2>/dev/null || true

exit 0
