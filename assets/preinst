#!/bin/bash
# preinst - pre-install / pre-upgrade handling (TOS requirement: the dedicated user must be created here)
set -e

MAINT_LOG=/var/log/kavita-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') preinst $*" >> "$MAINT_LOG" 2>/dev/null || true

# Create the dedicated system user (the platform install path creates it as well; this covers manual apt install;
# --user-group explicitly creates a same-named primary group instead of relying on USERGROUPS_ENAB defaults)
if ! id -u kavita > /dev/null 2>&1; then
  useradd --system --user-group --no-create-home --shell /usr/sbin/nologin kavita 2>/dev/null || true
fi

# Data directory (target of the /usr/local/kavita/bin/config symlink:
# database, covers, cache, logs, bookmarks, themes - all application state)
mkdir -p /var/lib/kavita
chown -R kavita:kavita /var/lib/kavita 2>/dev/null || true

exit 0
