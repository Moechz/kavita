[Unit]
Description=Kavita Reading Server (comics, manga, ebooks and magazines)
Documentation=https://wiki.kavitareader.com
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=kavita
Group=kavita
# All of Kavita's state directories (config/: database, covers, cache, logs, ...) are resolved
# relative to the process CWD (upstream DirectoryService/Program.cs uses GetCurrentDirectory).
# The CWD is /usr/local/kavita/bin (where the runtime assets live); its config entry is a
# symlink to /var/lib/kavita (shipped in the deb + self-healed by postinst), so every write lands on the data volume.
WorkingDirectory=/usr/local/kavita/bin
EnvironmentFile=-/usr/local/kavita/kavita.env
# ExecStart cannot take any arguments: Kavita has no CLI options for port/address/prefix - they all
# come from config/appsettings.json (bootstrapped by postinst on first install:
# Port=8500 / IpAddresses=127.0.0.1 / BaseUrl=/kavita/）。
# the safety net for the listening address and sub-path therefore lives in the appsettings template plus
# the verify assertions, not in this unit. Never introduce $ variables here (systemd only expands plain ${VAR}).
ExecStart=/usr/local/kavita/bin/Kavita
TimeoutStartSec=30
# Kavita drains background tasks after SIGTERM (upstream OnShutdown has a 1s grace period)
TimeoutStopSec=15
# Note: per TOS requirements, no Restart/RestartSec - the App Center manages the lifecycle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kavita
# Single-file write access: on startup Kavita writes BaseUrl back into wwwroot/index.html's
# <base href> (UpdateBaseUrlInIndex; SPA asset resolution under a sub-path depends on it).
# The build stage pre-writes the same value, so letting the app self-heal avoids an error log on every start)
ReadWritePaths=/usr/local/kavita/bin/wwwroot/index.html
LimitNOFILE=65536
UMask=0027
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
